# 生产域名（用户端 / 管理端）
NEXT_PUBLIC_WEB_HOST=velvetmovie.space
NEXT_PUBLIC_ADMIN_HOST=admin.velvetmovie.space
NEXT_PUBLIC_SITE_URL=https://velvetmovie.space
NEXT_PUBLIC_ADMIN_URL=https://admin.velvetmovie.space

# Next rewrites + SSR/middleware drama checks → Nest origin
# Default matches services/api PORT (4000). Production: http://127.0.0.1:4100
API_PROXY_TARGET=http://127.0.0.1:4000

# 本地访问 /admin|/ops|/console 时跳转到独立管理端
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# UI locale resolve order: saved choice → cookie → system language.
# Supported: zh / en / fr (see lib/languages.ts). Unsupported → English.
# Browser API traffic uses same-origin "/api/v1" (apps/web/lib/api.ts); do not set NEXT_PUBLIC_API_BASE.
