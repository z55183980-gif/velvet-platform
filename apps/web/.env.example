# 后台前端入口。默认 /admin；若要隐蔽入口可改为 /ops 或 /x7k2m
NEXT_PUBLIC_ADMIN_BASE_PATH=/admin

# 生产域名（用户端 / 管理端分域）
NEXT_PUBLIC_WEB_HOST=<web-host>
NEXT_PUBLIC_ADMIN_HOST=<admin-host>
NEXT_PUBLIC_SITE_URL=https://<web-host>
NEXT_PUBLIC_ADMIN_URL=https://<admin-host>

# API 入口（开发示例：http://localhost:4000/api/v1；生产改为实际 API 地址）
NEXT_PUBLIC_API_BASE=<api-base-url>

# 界面语言：优先本地已选 → cookie → 系统语言；不在支持列表（zh/en/fr/ru/vi）时兜底 English
# NEXT_PUBLIC_DEFAULT_LOCALE 不再强制覆盖系统语言
NEXT_PUBLIC_DEFAULT_LOCALE=
