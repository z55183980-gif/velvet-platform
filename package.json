{
  "name": "velvet-platform",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=velvet-web",
    "dev:admin": "turbo run dev --filter=velvet-admin",
    "dev:api": "turbo run start:dev --filter=velvet-api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --filter=velvet-web",
    "prisma:generate": "pnpm --filter velvet-api prisma:generate"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  }
}
