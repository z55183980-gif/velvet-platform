# Copy to .env and fill in. Do not commit .env.

API_BASE_URL=http://127.0.0.1:3001/api/v1

# Prefer pasting JWT from admin browser (localStorage key: dv_admin_token)
ADMIN_TOKEN=

# Or login when AUTH_ADMIN_CAPTCHA_DISABLED=true on API
# ADMIN_ACCOUNT=
# ADMIN_PASSWORD=

OPENAI_API_KEY=
# Optional proxy / compatible gateway (default https://api.openai.com/v1)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

POC_CATEGORY_SLUG=do_thi
POC_MAX_EPISODES=20
