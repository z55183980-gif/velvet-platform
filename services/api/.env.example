# ===== 运行时环境变量（复制为 .env 后填入真实值）=====
NODE_ENV=<development|production>

PORT=<port>
# 逗号分隔；需同时包含用户端与管理端 origin
ALLOWED_ORIGINS=https://velvetmovie.space,https://www.velvetmovie.space,https://admin.velvetmovie.space

DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

JWT_SECRET="<jwt-secret>"
JWT_EXPIRES_IN="<jwt-expires-in>"

OTP_TTL_SECONDS=<otp-ttl-seconds>
OTP_LENGTH=<otp-length>

CDN_BASE_URL="https://cdn.velvetmovie.space"
CDN_SIGN_KEY="<cdn-sign-key>"
CDN_SIGN_KEY_PAIR_ID="<cdn-key-pair-id>"

# Cloudflare R2（对象存储；播放域名见 CDN_BASE_URL）
R2_ACCOUNT_ID=<account-id>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_REGION=auto
R2_UPLOAD_BUCKET=velvet-uploads
R2_MEDIA_BUCKET=velvet-media
STORAGE_BACKEND=r2

WEBHOOK_SECRET="<webhook-secret>"
PLATFORM_FEE_RATE=<platform-fee-rate>

ADMIN_BOOTSTRAP_EMAIL=<admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<admin-password>
ADMIN_BOOTSTRAP_USERNAME=<admin-username>
# 已废弃：静态 ADMIN_TOKEN / x-admin-token 旁路已移除，仅 JWT
# ADMIN_TOKEN=

SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_SECURE=<true|false>
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=<smtp-from>
SMTP_FROM_NAME=<smtp-from-name>

AUTH_EMAIL_OTP_ENABLED=<true|false>
AUTH_PHONE_OTP_ENABLED=<true|false>
# 设为 true/1/yes 可关闭管理端登录图形验证码（默认开启）
# AUTH_ADMIN_CAPTCHA_DISABLED=false

STORAGE_ROOT=<storage-root>
FFMPEG_PATH=<ffmpeg-path>

PUBLIC_BASE_URL=<public-api-base-url>
WEB_BASE_URL=https://velvetmovie.space
ADMIN_WEB_BASE_URL=https://admin.velvetmovie.space

# 红果短剧第三方解析（半自动导入）；未配置时后台仅可用手动外链
# HONGGUO_API_BASE=https://www.52api.cn/api/hg_duanju
# HONGGUO_API_KEY=<your-api-key>
