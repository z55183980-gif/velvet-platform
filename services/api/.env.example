# ===== 运行时环境变量（复制为 .env 后填入真实值）=====
NODE_ENV=<development|production>

PORT=<port>
# 逗号分隔；需同时包含用户端与管理端 origin
ALLOWED_ORIGINS=https://velvetmovie.space,https://www.velvetmovie.space,https://admin.velvetmovie.space

DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

# 生产：JWT_SECRET / CDN_SIGN_KEY 必填且 ≥16 字符；弱值或缺失会 fail-fast 拒绝启动
JWT_SECRET="<jwt-secret>"
JWT_EXPIRES_IN="<jwt-expires-in>"
# 卡密 HMAC pepper；未设置时回退 JWT_SECRET。生产务必单独配置且勿轮换（轮换会导致旧码无法兑换）
REDEEM_CODE_PEPPER="<redeem-code-pepper>"

OTP_TTL_SECONDS=<otp-ttl-seconds>
OTP_LENGTH=<otp-length>

CDN_BASE_URL="https://cdn.velvetmovie.space"
CDN_SIGN_KEY="<cdn-sign-key>"
CDN_SIGN_KEY_PAIR_ID="<cdn-key-pair-id>"

# Cloudflare R2（对象存储；播放域名见 CDN_BASE_URL）
R2_ACCOUNT_ID=<account-id>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_REGION=auto
R2_UPLOAD_BUCKET=velvet-uploads
R2_MEDIA_BUCKET=velvet-media
STORAGE_BACKEND=r2
# Optional: Account API token with R2 read + Analytics — storage probe + /admin/ops-monitor
# Scopes: Account.R2 read, Account Analytics read; for CDN charts also Zone Analytics read
# (falls back to a bounded ListObjects sum, up to ~3k keys/bucket, marked approx)
# CLOUDFLARE_API_TOKEN=<token-with-account-r2-read>
# R2_API_TOKEN=<alias-of-CLOUDFLARE_API_TOKEN>
# Optional: zone id for CDN HTTP traffic charts (velvetmovie.space / cdn host zone)
# CLOUDFLARE_ZONE_ID=<zone-id>
# Browser direct PUT: configure CORS on velvet-uploads
# AllowedOrigins = admin origin(s); AllowedMethods = PUT, HEAD; AllowedHeaders = *

WEBHOOK_SECRET="<webhook-secret>"
PLATFORM_FEE_RATE=<platform-fee-rate>

# 生产：bootstrap 仅在配置了邮箱+强密码（≥12）且库中无该账号时创建；POST /bootstrap 在生产禁用
ADMIN_BOOTSTRAP_EMAIL=<admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<admin-password-min-12-chars>
ADMIN_BOOTSTRAP_USERNAME=<admin-username>
# 已废弃：静态 ADMIN_TOKEN / x-admin-token 旁路已移除，仅 JWT
# ADMIN_TOKEN=

SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_SECURE=<true|false>
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=<smtp-from>
SMTP_FROM_NAME=<smtp-from-name>

AUTH_EMAIL_OTP_ENABLED=<true|false>
AUTH_PHONE_OTP_ENABLED=<true|false>
# 设为 true/1/yes 可关闭管理端登录图形验证码（默认开启）
# AUTH_ADMIN_CAPTCHA_DISABLED=false
# 设为 true/1/yes 可关闭用户端登录/注册图形验证码（默认开启）
# AUTH_WEB_CAPTCHA_DISABLED=false

# Google OAuth（Web 弹窗登录；配齐后 /v1/auth/channels.google.enabled=true）
# Google Cloud Console → OAuth 客户端（Web）：
# - Authorized JavaScript origins = WEB_BASE_URL（如 https://velvetmovie.space）
# - Authorized redirect URIs = GOOGLE_REDIRECT_URI（默认 {WEB_BASE_URL}/api/v1/auth/google/callback）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://velvetmovie.space/api/v1/auth/google/callback
# AUTH_WEB_ORIGIN=https://velvetmovie.space

STORAGE_ROOT=<storage-root>
FFMPEG_PATH=<ffmpeg-path>

# Redis：转码队列 + OTP 存储（生产强烈建议配置，否则 OTP 仅进程内存）
# - 不设 REDIS_URL：API 进程内队列 / 内存 OTP（本地开发默认）
# - 设 REDIS_URL + TRANSCODE_INLINE=false + 单独跑 worker：生产推荐
# REDIS_URL=redis://127.0.0.1:6379
# TRANSCODE_INLINE=false
# TRANSCODE_CONCURRENCY=1

PUBLIC_BASE_URL=<public-api-base-url>
WEB_BASE_URL=https://velvetmovie.space
ADMIN_WEB_BASE_URL=https://admin.velvetmovie.space

# Stripe 支付网关（管理端「系统配置 → 支付网关」可写入；亦可手填）
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_WEBHOOK_SECRETS=whsec_old,whsec_new
# STRIPE_WEBHOOK_ALLOW_STORE_SECRET=true
# STRIPE_WEBHOOK_PUBLIC_URL=<optional-override-of-PUBLIC_BASE_URL-for-webhook-url>
# BACKEND_PUBLIC_URL=<alias-of-PUBLIC_BASE_URL>

# OpenAI 兼容网关（标题 EN→ZH/FR 翻译；POC Path B AI 抽取）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 公开链接导入（本地 yt-dlp，无需 API Key）
# - 默认 YTDLP_AUTO_INSTALL=true：启动时若 PATH 无 yt-dlp，则下载官方二进制到 STORAGE_ROOT/bin
# - Docker 镜像可预装并设 YTDLP_BIN=/usr/local/bin/yt-dlp、YTDLP_AUTO_INSTALL=false
# YTDLP_BIN=
# YTDLP_BIN_DIR=
# YTDLP_TIMEOUT_MS=90000
# YTDLP_ENABLED=true
# YTDLP_AUTO_INSTALL=true
# YTDLP_DOWNLOAD_BASE=https://github.com/yt-dlp/yt-dlp/releases/latest/download
# 会员站登录态（Netscape cookies / Bearer / 自定义头）
# - 全局 cookie 文件：
# YTDLP_COOKIES_FILE=/secure/all.cookies.txt
# - 按域名自动选用：把 reelshort.com.txt 放到 STORAGE_ROOT/secrets/cookies/
# YTDLP_COOKIES_DIR=
# - Bearer（Authorization: Bearer …）：
# YTDLP_AUTH_BEARER=
# - 额外请求头，换行或 || 分隔，如 Cookie: a=b||X-Api-Key: k
# YTDLP_ADD_HEADERS=
