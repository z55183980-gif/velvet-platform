# ===== 运行时环境变量（本地开发样例）=====
NODE_ENV=development

# API 服务
PORT=4000
# 允许的前端跨域来源（开发：Next.js :3000；生产：同源路径分区）
ALLOWED_ORIGINS=http://localhost:3000

# 数据库（PostgreSQL 16，UTF8，vi_VN/zh_CN ICU collation）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dramavn?schema=public"

# 会话 JWT（生产必须替换为强随机值并通过密钥管理）
JWT_SECRET="dev-secret-change-me-in-production"
JWT_EXPIRES_IN="30d"

# OTP（本地内存存储，生产替换为短信网关 + Redis）
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# 视频 CDN（HLS 签名播放，生产填入 CloudFront/OSS 私钥；此处为占位）
CDN_BASE_URL="https://cdn.dramavn.example.com"
CDN_SIGN_KEY="dev-cdn-sign-key"
CDN_SIGN_KEY_PAIR_ID="DEVKEYPAIR"

# 支付渠道（开源版仅保留抽象骨架）
# 真实渠道凭据由部署方在自己环境注入；不要把任何密钥提交到 git。
WEBHOOK_SECRET="dev-webhook"

# 平台分润比例（与 Creator.revenueShare 互补）
PLATFORM_FEE_RATE=0.30

# 管理员引导（首次启动时若无此账号会自动创建；生产务必改成强密码）
ADMIN_TOKEN=dev-admin
ADMIN_BOOTSTRAP_EMAIL=admin@dramavn.local
ADMIN_BOOTSTRAP_PASSWORD=admin
ADMIN_BOOTSTRAP_USERNAME=admin

# ===== 邮件 OTP（可选项，对齐 AI电影梦 mailer）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=DramaVN

# 鉴权通道开关（生产按需打开）
AUTH_EMAIL_OTP_ENABLED=false
AUTH_PHONE_OTP_ENABLED=false

# ===== 上传 / 转码 =====
STORAGE_ROOT=./storage
FFMPEG_PATH=ffmpeg

# 公网回调地址
PUBLIC_BASE_URL=http://127.0.0.1:4000
WEB_BASE_URL=http://localhost:3000
