{
  "name": "velvet-api",
  "version": "0.1.0",
  "description": "Velvet 短剧平台 API 服务 (NestJS + Prisma)",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "prelint": "prisma generate",
    "lint": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:normalize-credits": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/normalize-episode-credits.ts",
    "prisma:backfill-media": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/backfill-episode-media.ts",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "alipay-sdk": "^4.14.0",
    "bullmq": "^6.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^18.1.0-beta.15",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
